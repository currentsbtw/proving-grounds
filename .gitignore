# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Impeccable: keep reports, contracts, approved mocks and the final captures; drop working state and interim captures
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/config.local.json
.impeccable/build/
.impeccable/review/*.png
!.impeccable/review/polish-*.png
!.impeccable/review/final-eliminated-1440.png

# Judge corpus: fetched by `npm run judge:corpus`, not committed
server/judge/corpus/

# Eval run output: one file per run, regenerated by `npm run eval:judge`
eval/results/

# Eval caches are written through a temp file and renamed; the temp is never committed
eval/*.tmp
